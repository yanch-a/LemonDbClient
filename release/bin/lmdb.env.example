# =============================================================================
# lemonDbClient 用户配置（复制本文件为 lmdb.env 后修改）
#
# 只改这里：MySQL、Redis、端口、JVM。
# 不要增加其它键，产品不会读取；也不要去改 jar 内的 application*.yml。
# =============================================================================

# ---------- 运行环境（可选） ----------
# JAVA_HOME=/usr/lib/jvm/java-8-openjdk
# JAVA_OPTS=-Xms512m -Xmx2048m -XX:+HeapDumpOnOutOfMemoryError
SERVER_PORT=7806

# ---------- MySQL（必填） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lemon_db_client
DB_USERNAME=root
DB_PASSWORD=changeMe

# 可选：完整 JDBC URL。填写后忽略上面的 DB_HOST / DB_PORT / DB_NAME
# DB_URL=jdbc:mysql://127.0.0.1:3306/lemon_db_client?characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# ---------- Redis（REDIS_ENABLED=true 时必填） ----------
# true=使用 Redis（推荐）；false=单机内存，无需 Redis 进程
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码请留空：REDIS_PASSWORD=
REDIS_PASSWORD=
# 业务缓存使用的 database
REDIS_DATABASE=0
# 登录会话使用的 database（与上一行共用同一 Redis，不要相同）
REDIS_AUTH_DATABASE=1
